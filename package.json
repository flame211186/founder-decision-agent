{
  "name": "@sangfei/founder-decision-agent",
  "version": "0.1.0-beta.0",
  "description": "Evidence-calibrated founder decision support with investor and operator perspectives.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "sangfei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flame211186/founder-decision-agent.git"
  },
  "homepage": "https://github.com/flame211186/founder-decision-agent#readme",
  "bugs": {
    "url": "https://github.com/flame211186/founder-decision-agent/issues"
  },
  "keywords": [
    "agent",
    "startup",
    "founder",
    "idea-validation",
    "due-diligence",
    "openai",
    "mcp"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.16.0",
  "bin": {
    "founder-decision": "./dist/cli.js",
    "founder-decision-mcp": "./dist/mcp.js",
    "founder-decision-server": "./dist/server.js",
    "founder-review-validate": "./scripts/validate-review-records.mjs",
    "founder-consent-validate": "./scripts/validate-real-case-consents.mjs",
    "founder-quality-review-validate": "./scripts/validate-live-quality-review.mjs",
    "founder-quality-eval": "./scripts/live-quality-eval.mjs",
    "founder-stable-audit": "./scripts/audit-stable-release.mjs",
    "founder-stable-decision-validate": "./scripts/validate-stable-release-decision.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js"
    },
    "./schemas/expert-review.v1.schema.json": "./evals/review/review-form.v1.schema.json",
    "./schemas/live-quality-eval.v1.schema.json": "./schemas/live-quality-eval.v1.schema.json",
    "./schemas/live-quality-review.v1.schema.json": "./schemas/live-quality-review.v1.schema.json",
    "./schemas/real-case-consent.v1.schema.json": "./schemas/real-case-consent.v1.schema.json",
    "./schemas/stable-release-audit.v1.schema.json": "./schemas/stable-release-audit.v1.schema.json",
    "./schemas/stable-release-decision.v1.schema.json": "./schemas/stable-release-decision.v1.schema.json",
    "./schemas/stable-release-evidence.v1.schema.json": "./schemas/stable-release-evidence.v1.schema.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "scripts/live-smoke.mjs",
    "scripts/live-quality-eval.mjs",
    "scripts/live-quality-eval.d.mts",
    "scripts/audit-stable-release.mjs",
    "scripts/validate-live-quality-review.mjs",
    "scripts/validate-real-case-consents.mjs",
    "scripts/validate-review-records.mjs",
    "scripts/validate-stable-release-decision.mjs",
    "evals/review/review-form.v1.schema.json",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && npm run check:scripts",
    "check:scripts": "node --check scripts/live-smoke.mjs && node --check scripts/live-quality-eval.mjs && node --check scripts/audit-stable-release.mjs && node --check scripts/verify-release-gate.mjs && node --check scripts/validate-all-reports.mjs && node --check scripts/validate-doc-links.mjs && node --check scripts/validate-live-quality-review.mjs && node --check scripts/validate-report-semantics.mjs && node --check scripts/validate-real-case-consents.mjs && node --check scripts/validate-review-records.mjs && node --check scripts/validate-stable-release-decision.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:offline": "npm run test:coverage && npm run validate:fixtures",
    "eval:live": "node scripts/live-smoke.mjs",
    "eval:quality": "node scripts/live-quality-eval.mjs",
    "validate:quality-review": "node scripts/validate-live-quality-review.mjs",
    "validate:consents": "node scripts/validate-real-case-consents.mjs",
    "validate:reviews": "node scripts/validate-review-records.mjs",
    "audit:stable": "node scripts/audit-stable-release.mjs",
    "validate:stable-decision": "node scripts/validate-stable-release-decision.mjs",
    "validate:fixtures": "node scripts/validate-all-reports.mjs",
    "validate:docs": "node scripts/validate-doc-links.mjs",
    "prepack": "npm run build && npm run test && npm run validate:fixtures && npm run validate:docs",
    "pack:dry": "npm pack --dry-run",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "openai": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
