{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:founder-decision-agent:schema:real-case-consent:v1",
  "title": "Founder Decision Agent Real Case Consent Record v1",
  "description": "A pseudonymous process record proving that a real evaluation case has explicit processing consent and completed de-identification. It must not contain names, contact details, raw submissions or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consent_record_id",
    "case_id",
    "case_version",
    "participant_id",
    "jurisdiction",
    "record_status",
    "consent",
    "withdrawal",
    "deidentification",
    "data_handling"
  ],
  "properties": {
    "schema_version": {
      "const": "real_case_consent.v1"
    },
    "consent_record_id": {
      "$ref": "#/definitions/pseudonymousId"
    },
    "case_id": {
      "type": "string",
      "pattern": "^real_[a-z0-9][a-z0-9_-]{6,59}$"
    },
    "case_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
    },
    "participant_id": {
      "$ref": "#/definitions/pseudonymousId"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"
    },
    "record_status": {
      "enum": [
        "pending",
        "eligible",
        "withdrawn_excluded"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obtained_at",
        "method",
        "obtained_by",
        "withdrawal_process_explained",
        "data_processors_disclosed",
        "retention_policy_disclosed",
        "scopes"
      ],
      "properties": {
        "obtained_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "enum": [
            "signed_written",
            "digital_affirmation",
            "recorded_verbal"
          ]
        },
        "obtained_by": {
          "$ref": "#/definitions/pseudonymousId"
        },
        "withdrawal_process_explained": {
          "type": "boolean"
        },
        "data_processors_disclosed": {
          "type": "boolean"
        },
        "retention_policy_disclosed": {
          "type": "boolean"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_evaluation",
            "external_model_processing",
            "deidentified_expert_review",
            "public_release"
          ],
          "properties": {
            "agent_evaluation": {
              "type": "boolean"
            },
            "external_model_processing": {
              "type": "boolean"
            },
            "deidentified_expert_review": {
              "type": "boolean"
            },
            "public_release": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "requested",
        "requested_at",
        "processed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "withdrawn_excluded"
          ]
        },
        "requested": {
          "type": "boolean"
        },
        "requested_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "processed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at",
        "completed_by",
        "direct_identifiers_removed",
        "indirect_identifiers_generalized",
        "organization_and_person_names_replaced",
        "secrets_removed",
        "free_text_manually_reviewed",
        "reidentification_risk",
        "verification"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_by": {
          "anyOf": [
            {
              "$ref": "#/definitions/pseudonymousId"
            },
            {
              "type": "null"
            }
          ]
        },
        "direct_identifiers_removed": {
          "type": "boolean"
        },
        "indirect_identifiers_generalized": {
          "type": "boolean"
        },
        "organization_and_person_names_replaced": {
          "type": "boolean"
        },
        "secrets_removed": {
          "type": "boolean"
        },
        "free_text_manually_reviewed": {
          "type": "boolean"
        },
        "reidentification_risk": {
          "enum": [
            "unassessed",
            "low",
            "medium",
            "high"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "status",
            "verified_at",
            "verified_by",
            "deidentified_case_sha256"
          ],
          "properties": {
            "method": {
              "enum": [
                "self_review_pending",
                "independent_second_person"
              ]
            },
            "status": {
              "enum": [
                "pending",
                "verified"
              ]
            },
            "verified_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verified_by": {
              "anyOf": [
                {
                  "$ref": "#/definitions/pseudonymousId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "deidentified_case_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_source_storage",
        "repository_contains_raw_source",
        "consent_record_contains_direct_identifiers",
        "deidentified_artifact_location",
        "deletion_process_available"
      ],
      "properties": {
        "raw_source_storage": {
          "const": "restricted_outside_repository"
        },
        "repository_contains_raw_source": {
          "const": false
        },
        "consent_record_contains_direct_identifiers": {
          "const": false
        },
        "deidentified_artifact_location": {
          "enum": [
            "private_eval_workspace",
            "consented_public_fixture"
          ]
        },
        "deletion_process_available": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "pseudonymousId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{7,63}$"
    }
  }
}
