            "partially_verified",
            "unverified",
            "not_applicable"
          ]
        },
        "source_tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "E"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessed_at": {
                "type": "string",
                "format": "date"
              },
              "source_tier": {
                "type": "integer"
              }
            }
          }
