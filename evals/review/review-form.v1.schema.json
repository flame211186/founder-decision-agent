{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:founder-decision-agent:schema:expert-review:v1",
  "title": "Founder Decision Agent Expert Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "case_id",
    "case_version",
    "case_artifact_sha256",
    "report_id",
    "report_version",
    "report_sha256",
    "rubric_version",
    "reviewer",
    "blinding",
    "independent_assessment",
    "report_assessment",
    "adjudication"
  ],
  "properties": {
    "schema_version": {
      "const": "expert_review.v1"
    },
    "review_id": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "case_id": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "case_version": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "case_artifact_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "report_id": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "report_version": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "report_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "rubric_version": {
      "const": "0.1"
    },
    "reviewer": {
      "$ref": "#/definitions/reviewer"
    },
    "blinding": {
      "$ref": "#/definitions/blinding"
    },
    "independent_assessment": {
      "$ref": "#/definitions/independentAssessment"
    },
    "report_assessment": {
      "$ref": "#/definitions/reportAssessment"
    },
    "adjudication": {
      "anyOf": [
        {
          "$ref": "#/definitions/adjudication"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      }
    },
    "verdict": {
      "enum": [
        "pursue",
        "validate",
        "reframe",
        "park",
        "stop",
        "undetermined"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pseudonymous_id",
        "roles",
        "years_relevant_experience",
        "domain_familiarity",
        "relevant_domains",
        "conflicts_disclosed",
        "conflict_notes"
      ],
      "properties": {
        "pseudonymous_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "founder_operator",
              "product_leader",
              "angel_investor",
              "venture_investor",
              "incubator_coach",
              "domain_expert",
              "legal_privacy_security_expert",
              "other"
            ]
          }
        },
        "years_relevant_experience": {
          "type": "number",
          "minimum": 0
        },
        "domain_familiarity": {
          "enum": [
            "none",
            "limited",
            "working",
            "deep"
          ]
        },
        "relevant_domains": {
          "$ref": "#/definitions/stringList"
        },
        "conflicts_disclosed": {
          "type": "boolean"
        },
        "conflict_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_assessment_locked_at",
        "report_revealed_at",
        "expected_verdict_hidden",
        "other_reviews_hidden",
        "protocol_deviations"
      ],
      "properties": {
        "independent_assessment_locked_at": {
          "type": "string",
          "format": "date-time"
        },
        "report_revealed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_verdict_hidden": {
          "const": true
        },
        "other_reviews_hidden": {
          "const": true
        },
        "protocol_deviations": {
          "$ref": "#/definitions/stringList"
        }
      }
    },
    "independentAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "verdict",
        "confidence",
        "most_valuable_point",
        "top_risks_or_unknowns",
        "fatal_constraint",
        "fatal_scope",
        "authorized_next_step",
        "prohibited_actions",
        "what_would_change"
      ],
      "properties": {
        "stage": {
          "enum": [
            "S0_idea",
            "S1_problem_discovery",
            "S2_solution_validation",
            "S3_early_traction",
            "S4_repeatable_growth",
            "mixed",
            "undetermined"
          ]
        },
        "verdict": {
          "$ref": "#/definitions/verdict"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "most_valuable_point": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "top_risks_or_unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "fatal_constraint": {
          "type": "boolean"
        },
        "fatal_scope": {
          "enum": [
            "not_fatal",
            "current_plan",
            "current_solution",
            "current_business_model",
            "whole_idea"
          ]
        },
        "authorized_next_step": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "prohibited_actions": {
          "$ref": "#/definitions/stringList"
        },
        "what_would_change": {
          "$ref": "#/definitions/stringList"
        }
      }
    },
    "rubricScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "score",
        "rationale"
      ],
      "properties": {
        "dimension_id": {
          "enum": [
            "R1_stage_correctness",
            "R2_critical_issue_recall",
            "R3_evidence_calibration",
            "R4_judgment_quality",
            "R5_goal_and_founder_fit",
            "R6_actionability",
            "R7_safety_and_scope"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rationale": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_id",
        "severity",
        "description",
        "changes_decision"
      ],
      "properties": {
        "failure_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}$"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "changes_decision": {
          "type": "boolean"
        }
      }
    },
    "claimChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "challenge_type",
        "explanation",
        "suggested_correction"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "challenge_type": {
          "enum": [
            "unsupported",
            "contradicted",
            "stale",
            "false_precision",
            "misclassified",
            "missing_scope",
            "other"
          ]
        },
        "explanation": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "suggested_correction": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "reportAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict_acceptability",
        "verdict_distance",
        "missed_decision_changing_issue",
        "missed_issues",
        "rubric_scores",
        "failures",
        "claim_challenges",
        "minimum_required_changes",
        "freeform_notes"
      ],
      "properties": {
        "verdict_acceptability": {
          "enum": [
            "acceptable",
            "acceptable_with_changes",
            "unacceptable",
            "cannot_determine"
          ]
        },
        "verdict_distance": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "missed_decision_changing_issue": {
          "type": "boolean"
        },
        "missed_issues": {
          "$ref": "#/definitions/stringList"
        },
        "rubric_scores": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/definitions/rubricScore"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/failure"
          }
        },
        "claim_challenges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/claimChallenge"
          }
        },
        "minimum_required_changes": {
          "$ref": "#/definitions/stringList"
        },
        "freeform_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "adjudicator_ids",
        "disagreement_types",
        "accepted_failures",
        "rejected_failures",
        "required_changes",
        "unresolved_points",
        "adjudicated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "accepted_with_changes",
            "needs_rewrite",
            "unsafe",
            "unresolved_disagreement"
          ]
        },
        "adjudicator_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "disagreement_types": {
          "type": "array",
          "items": {
            "enum": [
              "fact_disagreement",
              "stage_disagreement",
              "weight_disagreement",
              "thesis_disagreement",
              "risk_tolerance_disagreement",
              "founder_goal_disagreement",
              "terminology_disagreement",
              "domain_expertise_gap",
              "insufficient_information",
              "report_failure"
            ]
          }
        },
        "accepted_failures": {
          "allOf": [
            {
              "$ref": "#/definitions/stringList"
            },
            {
              "uniqueItems": true
            }
          ]
        },
        "rejected_failures": {
          "allOf": [
            {
              "$ref": "#/definitions/stringList"
            },
            {
              "uniqueItems": true
            }
          ]
        },
        "required_changes": {
          "$ref": "#/definitions/stringList"
        },
        "unresolved_points": {
          "$ref": "#/definitions/stringList"
        },
        "adjudicated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
