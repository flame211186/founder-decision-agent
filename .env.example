# Required for the default OpenAI adapter. Never commit a real key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-terra for quick mode and gpt-5.6-sol for deep mode.
FOUNDER_DECISION_QUICK_MODEL=gpt-5.6-terra
FOUNDER_DECISION_DEEP_MODEL=gpt-5.6-sol

# Optional live-quality baseline repeat count. Allowed range: 2-5; default: 3.
FOUNDER_DECISION_QUALITY_REPEATS=3

# Optional stable, privacy-preserving identifier supplied by the host application.
FOUNDER_DECISION_SAFETY_IDENTIFIER=
